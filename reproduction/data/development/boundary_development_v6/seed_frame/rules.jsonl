{"definition_id": "cuadfull:170:Products", "term": "Products", "contract_index": 170, "source_quote": "shall mean PAPA JOHN'S-branded pizza, bread sides, and, subject to ABG's Approval in each instance, piadinas and desserts (excluding pastries, doughnuts, coffee and coffee-based products, energy drinks, 'hydration' frozen ice bars, 'energy' frozen ice bars, and 'recovery' frozen ice bars), in each case produced and sold by PAPA JOHN'S.", "fields": {"kind": ["pizza", "bread_side", "piadina", "dessert", "doughnut", "coffee", "other"], "pj_brand": [true, false], "pj_made_sold": [true, false], "abg_approval": [true, false]}, "predicate": {"all": [{"eq": {"field": "pj_brand", "value": true}}, {"eq": {"field": "pj_made_sold", "value": true}}, {"any": [{"in": {"field": "kind", "values": ["pizza", "bread_side"]}}, {"all": [{"in": {"field": "kind", "values": ["piadina", "dessert"]}}, {"eq": {"field": "abg_approval", "value": true}}]}]}]}, "lexical_name_exemptions": ["PAPA", "JOHN'S", "ABG"], "source_quote_sha256": "f18ff07e9e82a9fb34406e82d9441d352f6a9f419db1da322d54f82c7f292347", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:108:Third Party", "term": "Third Party", "contract_index": 108, "source_quote": "means any Person other than Xencor, Aimmune or their respective Affiliates.", "fields": {"is_person": [true, false], "is_named_party": [true, false], "is_affiliate": [true, false]}, "predicate": {"all": [{"eq": {"field": "is_person", "value": true}}, {"eq": {"field": "is_named_party", "value": false}}, {"eq": {"field": "is_affiliate", "value": false}}]}, "lexical_name_exemptions": ["Xencor", "Aimmune"], "source_quote_sha256": "5b84461f6ffb9aedb5e710df86a85cb0558d6f1ee47a81bc9436f456dea3590e", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:250:System Images", "term": "System Images", "contract_index": 250, "source_quote": "means the files related to the OS and applications, but excluding Customer data files.", "fields": {"os_or_app_file": [true, false], "customer_data": [true, false]}, "predicate": {"all": [{"eq": {"field": "os_or_app_file", "value": true}}, {"eq": {"field": "customer_data", "value": false}}]}, "lexical_name_exemptions": ["IBM", "Customer"], "source_quote_sha256": "bc8c6fcf79a22053e1d8fedf0ddc6edad38a49d4c9d506ce604897666145fb1f", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:171:Confidential Information", "term": "Confidential Information", "contract_index": 171, "source_quote": "shall mean any information disclosed by one party to another pursuant to this Agreement which is marked as confidential or proprietary, or, if disclosed orally, is designated as confidential at the time of disclosure and is subsequently reduced to a writing which is marked as confidential or proprietary and is provided to the receiving party within thirty (30) days after such oral disclosure.", "fields": {"under_agreement": [true, false], "written": [true, false], "marked": [true, false], "oral_designated": [true, false], "followup_within30": [true, false]}, "predicate": {"all": [{"eq": {"field": "under_agreement", "value": true}}, {"any": [{"all": [{"eq": {"field": "written", "value": true}}, {"eq": {"field": "marked", "value": true}}]}, {"all": [{"eq": {"field": "written", "value": false}}, {"eq": {"field": "oral_designated", "value": true}}, {"eq": {"field": "followup_within30", "value": true}}]}]}]}, "lexical_name_exemptions": [], "source_quote_sha256": "0434b1e2345e3a6429b23ba720b02eff79e9ebfe61561f30dc0eaa37b945bad9", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:38:New Product", "term": "New Product", "contract_index": 38, "source_quote": "means a product developed by or on behalf of ENERGOUS after the Effective Date that is not a Product Update; provided, however, that \"New Products\" exclude any product developed by a successor or acquirer of ENERGOUS.", "fields": {"after_effective": [true, false], "by_energous": [true, false], "update": [true, false], "successor": [true, false]}, "predicate": {"all": [{"eq": {"field": "after_effective", "value": true}}, {"eq": {"field": "by_energous", "value": true}}, {"eq": {"field": "update", "value": false}}, {"eq": {"field": "successor", "value": false}}]}, "lexical_name_exemptions": ["ENERGOUS", "DIALOG"], "source_quote_sha256": "1ff42093b3720c6034209aa7ab156bd98b00b6e91e9c5a6f735515dd496471b5", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:152:Territory", "term": "Territory", "contract_index": 152, "source_quote": "1.37 \"Territory\" shall mean the fifty states of the United States of America, the District of Columbia, the Commonwealth of Puerto Rico, Guam, American Samoa, the U.S. Virgin Islands and all territories and possessions of the United States of America and United States military bases.", "fields": {"location": ["us_state", "dc", "puerto_rico", "guam", "american_samoa", "us_virgin_islands", "us_base", "foreign"]}, "predicate": {"in": {"field": "location", "values": ["us_state", "dc", "puerto_rico", "guam", "american_samoa", "us_virgin_islands", "us_base"]}}, "lexical_name_exemptions": ["Guam", "American", "United States", "Puerto Rico"], "source_quote_sha256": "48d0b3e8c5efd192a40c7432d3c59751a057fb37bb8e65b9d2a524e222813580", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:187:TERRITORY", "term": "TERRITORY", "contract_index": 187, "source_quote": "1.4 \"TERRITORY\" shall mean all countries of the world except the United Kingdom.", "fields": {"is_country": [true, false], "uk": [true, false]}, "predicate": {"all": [{"eq": {"field": "is_country", "value": true}}, {"eq": {"field": "uk", "value": false}}]}, "lexical_name_exemptions": ["United Kingdom"], "source_quote_sha256": "b837bba2abca895ab4844c448063747ada5b3f1be83b08eedd1070a683f91b70", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:21:Excluded Goods", "term": "Excluded Goods", "contract_index": 21, "source_quote": "\"Excluded Goods\" means all (1) goods that are not owned by Merchant, including but not limited to goods that belong to sublessees, licensees, department lessees, or concessionaires of Merchant and (2) goods held by Merchant on memo, on consignment (except to the extent otherwise agreed by the applicable consignor), or as bailee.", "fields": {"not_owned": [true, false], "memo": [true, false], "consignment": [true, false], "consignor_override": [true, false], "bailee": [true, false]}, "predicate": {"any": [{"eq": {"field": "not_owned", "value": true}}, {"eq": {"field": "memo", "value": true}}, {"all": [{"eq": {"field": "consignment", "value": true}}, {"eq": {"field": "consignor_override", "value": false}}]}, {"eq": {"field": "bailee", "value": true}}]}, "lexical_name_exemptions": ["Merchant"], "source_quote_sha256": "6c60c7ed9ebf6b262c56006cc41560c5e843c4f88959a01ad292797ea0d4c23e", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:254:Product", "term": "Product", "contract_index": 254, "source_quote": "1.50 \"Product\" means shall mean any pharmaceutical product containing, as an active ingredient, one or more of Binimetinib or Encorafenib, including, without limitation, any Combination Product.", "fields": {"pharmaceutical": [true, false], "active": ["binimetinib", "encorafenib", "both", "other", "none"]}, "predicate": {"all": [{"eq": {"field": "pharmaceutical", "value": true}}, {"in": {"field": "active", "values": ["binimetinib", "encorafenib", "both"]}}]}, "lexical_name_exemptions": ["Binimetinib", "Encorafenib", "MGAH22"], "source_quote_sha256": "00df031059118421d9f346a6d3fcf7d0e80b22f12a4fa89d782072a2ab78a354", "status": "source_rule_seed_dev_only_not_formal_gold"}
{"definition_id": "cuadfull:450:Covered Regions", "term": "Covered Regions", "contract_index": 450, "source_quote": "\"Covered Regions\" shall mean Japan, North America, Europe, the Middle East and North Africa, Australia, Hong Kong and China.", "fields": {"region": ["japan", "north_america", "europe", "mena", "australia", "hong_kong", "china", "other"]}, "predicate": {"in": {"field": "region", "values": ["japan", "north_america", "europe", "mena", "australia", "hong_kong", "china"]}}, "lexical_name_exemptions": ["Japan", "North America", "Europe", "Middle East", "North Africa", "Australia", "Hong Kong", "China"], "source_quote_sha256": "2ef265324796669fdb1824384751544ddd924e0489a4d8b82c46ad0a4386791d", "status": "source_rule_seed_dev_only_not_formal_gold"}
